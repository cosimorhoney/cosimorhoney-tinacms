                ▟█████▛
               ▟█████▛
 ▟███▄▄       ▟█████▛
▟█████▛      ▟█████▛
▀▀███▛      ▟█████▛
           ▟█████▛
    ▄▄▂▂▂▄██████▛ 
   ████████████▘
  ▝▜███████▛▀▘
      ▔▔▔       TM 
-->
	<head>
		<BaseHead title={data.data.page.seoTitle} description={config.seo.description} />
	</head>
	<body>
		<Header />
				<Page {...data} client:tina />
		<Footer />
	</body>
</html>

